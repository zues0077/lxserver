{
  "manifest_version": 3,
  "name": "LX 音乐账号 Cookie 同步",
  "version": "1.0.3",
  "description": "在当前音乐平台页面一键读取登录 Cookie，同步到自己的 LX 服务器，无需手工复制。",
  "permissions": [
    "cookies",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.music.163.com/*",
    "*://*.qq.com/*",
    "*://*.kuwo.cn/*",
    "*://*.kugou.com/*",
    "*://*.migu.cn/*",
    "*://*.bilibili.com/*",
    "*://*.qishui.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "同步 Cookie 到 LX"
  }
}
